APP_NAME="Rudood Platform"
APP_ENV=local
APP_KEY=base64:3eAlwiDqI0si548hKFPKSMIZcK29t5JSVvOVQbHcibg=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database Configuration (Docker PostgreSQL with pgvector)
DB_CONNECTION=pgsql
