# Clean Direct HTTP Setup for Droplet IP: 178.128.38.186
:80 {
    # Route WebSocket connections for Live Chat
    @websocket {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    reverse_proxy @websocket websocket:3000

    handle /socket.io/* {
        reverse_proxy websocket:3000
    }

    # Route all standard web requests to Laravel Application
    handle {
        reverse_proxy app:80 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}
